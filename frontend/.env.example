# ── AWS Cognito ──────────────────────────────────────────────────────────────
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS Region ────────────────────────────────────────────────────────────────
VITE_AWS_REGION=us-east-1

# ── Cognito Identity Pool (para obtener credenciales AWS temporales) ──────────
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── AWS IoT Core ──────────────────────────────────────────────────────────────
# Endpoint de IoT Core (obtenido con: aws iot describe-endpoint --endpoint-type iot:Data-ATS)
VITE_IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com

# Nombre del Thing registrado en IoT Core (debe coincidir con tu iot-instance.tf)
VITE_IOT_THING_NAME=USV-001

# ── API Gateway (backend REST, si aplica) ──────────────────────────────────────
VITE_API_GATEWAY_URL=https://your-api-gateway-url.execute-api.us-east-1.amazonaws.com
