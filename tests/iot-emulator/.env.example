# AWS IoT Core Configuration
AWS_IOT_ENDPOINT=tu-endpoint.iot.us-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=usv-barquito-emulator

# Certificates Paths (Relative to iot-emulator directory)
AWS_IOT_PRIVATE_KEY_PATH=certs/private.pem.key
AWS_IOT_CERT_PATH=certs/device.pem.crt
AWS_IOT_CA_PATH=certs/AmazonRootCA1.pem
