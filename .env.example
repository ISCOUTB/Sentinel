# ==============================================================================
# SENTINEL PROJECT - CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================

# ==============================================================================
# BLOQUE A: INFRAESTRUCTURA Y NUBE (Cloud & DevOps)
# Controla el despliegue en AWS y la configuración de Terraform
# ==============================================================================

# --- AWS Global Access ---
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_REGION="us-east-1"

# --- Terraform Configuration (TF_VARs) ---
TF_VAR_my_access_key="YOUR_AWS_ACCESS_KEY_ID"
TF_VAR_my_secret_key="YOUR_AWS_SECRET_ACCESS_KEY"
TF_VAR_region_sentinel="us-east-1"
TF_VAR_repo_branch="develop"
TF_VAR_db_instance_name="sentinel-influx-instance"
TF_VAR_db_username="admin"
TF_VAR_db_password="secure-db-password"
TF_VAR_allocated_storage=20
TF_VAR_db_instance_type="db.influx.medium"
TF_VAR_publicly_accessible=true

# --- Infrastructure Services (Endpoints & IDs) ---
IOT_ENDPOINT="xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"
IOT_THING_NAME="USV-001"
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
COGNITO_APP_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"


# ==============================================================================
# BLOQUE B: APLICACIÓN CORE SENTINEL (HMI & Data)
# Componentes principales del sistema de cara al usuario
# ==============================================================================

# --- Backend (FastAPI) ---
PROJECT_NAME="USV HMI Backend"
SECRET_KEY="generate-a-long-random-secret-key"
API_V1_STR="/api/v1"
ACCESS_TOKEN_EXPIRE_MINUTES=360
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS="http://localhost:8080,http://localhost:3000"

# --- Database (MySQL) ---
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_DATABASE="usv_hmi"
MYSQL_USER="usv_user"
MYSQL_PASSWORD="usv_password"
DATABASE_URL="mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}"

# --- Frontend (Vite) ---
VITE_AWS_REGION="us-east-1"
VITE_COGNITO_USER_POOL_ID="us-east-1_XXXXXXXXX"
VITE_COGNITO_USER_POOL_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
VITE_COGNITO_IDENTITY_POOL_ID="us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
VITE_IOT_ENDPOINT="xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"
VITE_IOT_THING_NAME="USV-001"
VITE_IOT_POLICY_NAME="sentinel-hmi-policy"
VITE_API_GATEWAY_URL=""
VITE_API_TARGET="http://backend:8000"


# ==============================================================================
# BLOQUE C: HERRAMIENTAS ADICIONALES Y SIMULACIÓN
# Soporte para telemetría, IA y entorno de pruebas
# ==============================================================================

# --- IA & Reporting ---
GEMINI_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"

# --- Telemetry Storage (InfluxDB) ---
INFLUXDB_URL="http://sentinel-influxdb:8086"
INFLUXDB_ORG="sentinel-org"
INFLUXDB_BUCKET="mission"
INFLUXDB_TOKEN="generate-a-secure-admin-token"
INFLUXDB_USERNAME="admin"
INFLUXDB_PASSWORD="admin_password"

# InfluxDB Docker Initialization
DOCKER_INFLUXDB_INIT_MODE="setup"
DOCKER_INFLUXDB_INIT_USERNAME="admin"
DOCKER_INFLUXDB_INIT_PASSWORD="admin_password"
DOCKER_INFLUXDB_INIT_ORG="sentinel-org"
DOCKER_INFLUXDB_INIT_BUCKET="mission"
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN="generate-a-secure-admin-token"

# --- IoT Integration (Bridge & Emulator) ---
AWS_IOT_ENDPOINT="xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com"
AWS_IOT_PORT=8883
MQTT_KEEPALIVE=30
MQTT_TOPIC_FILTER="USV-001/+"
AWS_IOT_PRIVATE_KEY_PATH="/certs/private.pem.key"
AWS_IOT_CERT_PATH="/certs/device.pem.crt"
AWS_IOT_CA_PATH="/certs/AmazonRootCA1.pem"
TOPIC_BUCKET_MAP='{"USV-001/general_usv_status":"general_status","USV-001/mision":"mission","USV-001/logs":"logs"}'

# Unique Client IDs (To avoid MQTT conflicts)
AWS_IOT_CLIENT_ID="sentinel-influx-bridge"
EMULATOR_IOT_CLIENT_ID="sentinel-emulator-usv"

# ==============================================================================
# MAPEO AUTOMÁTICO PARA TERRAFORM (Consistencia)
# ==============================================================================
TF_VAR_secret_key=${SECRET_KEY}
TF_VAR_mysql_root_password=${MYSQL_ROOT_PASSWORD}
TF_VAR_mysql_database=${MYSQL_DATABASE}
TF_VAR_mysql_user=${MYSQL_USER}
TF_VAR_mysql_password=${MYSQL_PASSWORD}
TF_VAR_organization_name=${INFLUXDB_ORG}
TF_VAR_bucket_name=${INFLUXDB_BUCKET}
TF_VAR_user_pool_id=${COGNITO_USER_POOL_ID}
TF_VAR_user_pool_client_id=${COGNITO_APP_CLIENT_ID}
TF_VAR_cognito_identity_pool_id=${VITE_COGNITO_IDENTITY_POOL_ID}
TF_VAR_iot_endpoint=${IOT_ENDPOINT}
