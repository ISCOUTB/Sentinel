# ==============================================================================
# Sentinel Project - Global Configuration Example (.env.example)
# ==============================================================================

# --- AWS Credentials & Terraform ---
TF_VAR_my_access_key="YOUR_AWS_ACCESS_KEY"
TF_VAR_my_secret_key="YOUR_AWS_SECRET_KEY"
TF_VAR_region_sentinel="us-east-1"
TF_VAR_repo_branch="develop"

# Mapping for non-prefixed AWS variables
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
AWS_REGION="us-east-1"

# --- Backend Configuration ---
SECRET_KEY="your-secret-key"
PROJECT_NAME="USV HMI Backend"
API_V1_STR="/api/v1"
ACCESS_TOKEN_EXPIRE_MINUTES=360
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS="http://localhost:8080,http://localhost:3000,http://localhost:5173"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Database (MySQL) ---
MYSQL_ROOT_PASSWORD="rootpassword"
MYSQL_DATABASE="usv_hmi"
MYSQL_USER="usv_user"
MYSQL_PASSWORD="usv_password"
DATABASE_URL="mysql+pymysql://${MYSQL_USER}:${MYSQL_PASSWORD}@db:3306/${MYSQL_DATABASE}"

# --- AWS Cognito ---
COGNITO_REGION="us-east-1"
COGNITO_USER_POOL_ID="your-user-pool-id"
COGNITO_APP_CLIENT_ID="your-client-id"

# --- AWS IoT Core ---
IOT_ENDPOINT="your-iot-endpoint.iot.us-east-1.amazonaws.com"
IOT_THING_NAME="USV-001"

# --- InfluxDB ---
INFLUXDB_URL="http://sentinel-influxdb:8086"
INFLUXDB_ORG="sentinel-org"
INFLUXDB_BUCKET="mission"
INFLUXDB_TOKEN="your-influxdb-token"

# InfluxDB Initialization (Required for first run)
DOCKER_INFLUXDB_INIT_MODE="setup"
DOCKER_INFLUXDB_INIT_USERNAME="admin"
DOCKER_INFLUXDB_INIT_PASSWORD="your-influxdb-password"
DOCKER_INFLUXDB_INIT_ORG="sentinel-org"
DOCKER_INFLUXDB_INIT_BUCKET="mission"
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN="your-influxdb-token"

# InfluxDB Bridge Credentials (Mapping for the bridge service)
INFLUXDB_USERNAME="admin"
INFLUXDB_PASSWORD="your-influxdb-password"
INFLUXDB_INIT_ADMIN_TOKEN="your-influxdb-token"

# --- IoT-Influx Bridge & Emulator specific ---
AWS_IOT_ENDPOINT="your-iot-endpoint.iot.us-east-1.amazonaws.com"
AWS_IOT_CLIENT_ID="sentinel-influx-bridge"
AWS_IOT_PORT=8883
MQTT_KEEPALIVE=30
MQTT_TOPIC_FILTER="USV-001/+"
AWS_IOT_PRIVATE_KEY_PATH="/certs/private.pem.key"
AWS_IOT_CERT_PATH="/certs/device.pem.crt"
AWS_IOT_CA_PATH="/certs/AmazonRootCA1.pem"
TOPIC_BUCKET_MAP='{"USV-001/general_usv_status":"general_status","USV-001/mision":"mission","USV-001/logs":"logs"}'

# --- Frontend (Vite) ---
VITE_COGNITO_USER_POOL_ID="your-user-pool-id"
VITE_COGNITO_USER_POOL_CLIENT_ID="your-client-id"
VITE_AWS_REGION="us-east-1"
VITE_COGNITO_IDENTITY_POOL_ID="your-identity-pool-id"
VITE_IOT_ENDPOINT="your-iot-endpoint.iot.us-east-1.amazonaws.com"
VITE_IOT_THING_NAME="USV-001"
VITE_IOT_POLICY_NAME="sentinel-hmi-policy"
VITE_API_GATEWAY_URL="your-api-gateway-url"
VITE_API_TARGET="http://backend:8000"
