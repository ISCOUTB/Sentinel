# ==============================================================================
# Sentinel Project - Terraform Configuration Example (terraform.tfvars.example)
# ==============================================================================

# AWS Credentials
my_access_key = "YOUR_AWS_ACCESS_KEY"
my_secret_key = "YOUR_AWS_SECRET_KEY"
aws_region     = "us-east-1"

# Deployment Configuration
region_sentinel     = "us-east-1"
repo_branch         = "develop"
secret_key          = "your-secret-key"

# MySQL Configuration
mysql_root_password = "rootpassword"
mysql_database      = "usv_hmi"
mysql_user          = "usv_user"
mysql_password      = "usv_password"

# InfluxDB Configuration
db_instance_name    = "mi-influxdb-instance"
db_username         = "admin"
db_password         = "your-db-password"
organization_name   = "sentinel-org"
bucket_name         = "mission"
allocated_storage   = 20
db_instance_type    = "db.influx.medium"
publicly_accessible = true

# IoT Core Configuration
thing_name      = "USV-001"
iot_policy_name = "sentinel-hmi-policy"

# Lambda Function Configuration
lambda_function_name = "iot-to-influxdb"
