# ===== AWS IoT Core =====
AWS_IOT_ENDPOINT=your-endpoint-ats.iot.us-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=sentinel-influx-bridge
AWS_IOT_PORT=8883
MQTT_KEEPALIVE=30
MQTT_TOPIC_FILTER=usv/+/data
AWS_IOT_PRIVATE_KEY_PATH=/certs/private.pem.key
AWS_IOT_CERT_PATH=/certs/device.pem.crt
AWS_IOT_CA_PATH=/certs/AmazonRootCA1.pem

# ===== InfluxDB (local service name on compose network) =====
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=sentinel-org
INFLUXDB_BUCKET=general_status
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=admin123456

# Required by Influx container init
INFLUXDB_INIT_ADMIN_TOKEN=sentinel-local-admin-token-please-change

# Optional per-topic routing (JSON). If missing, INFLUXDB_BUCKET is used.
TOPIC_BUCKET_MAP={"usv/status/data":"general_status","usv/mission/data":"mission","usv/logs/data":"logs"}
