# --- Terraform AWS ---
# Llave de acceso AWS
TF_VAR_my_access_key="TU_ACCESS_KEY_AQUI"
# Clave secreta AWS
TF_VAR_my_secret_key="TU_SECRET_KEY_AQUI"
# Región de despliegue
TF_VAR_region_sentinel="us-east-1"

# --- Terraform Deployment ---
# Rama del repositorio a desplegar
TF_VAR_repo_branch="develop"

# --- Docker Compose (Local y Servidor) ---
# Backend
SECRET_KEY="your-secret-key-here-change-this-in-production"
TF_VAR_secret_key="your-secret-key-here-change-this-in-production"

PROJECT_NAME="USV HMI Backend"

# Database
MYSQL_ROOT_PASSWORD="rootpassword"
TF_VAR_mysql_root_password="rootpassword"

MYSQL_DATABASE="usv_hmi"
TF_VAR_mysql_database="usv_hmi"

MYSQL_USER="usv_user"
TF_VAR_mysql_user="usv_user"

MYSQL_PASSWORD="usv_password"
TF_VAR_mysql_password="usv_password"

# InfluxDB Timestream
TF_VAR_db_instance_name="mi-influxdb-instance"
TF_VAR_db_username="admin"
TF_VAR_db_password="tu-contraseña-segura-aqui"
TF_VAR_organization_name="mi-organizacion"
TF_VAR_bucket_name="mi-bucket-inicial"
TF_VAR_allocated_storage=20
TF_VAR_db_instance_type="db.influx.medium"
TF_VAR_publicly_accessible=true

# AWS Cognito Configuration
