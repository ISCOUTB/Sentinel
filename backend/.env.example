# Configuración del Backend USV HMI

# Clave secreta para JWT - CAMBIA ESTO EN PRODUCCIÓN
SECRET_KEY=your-secret-key-here-change-this-in-production

# Base de datos MySQL
DATABASE_URL=mysql+pymysql://usv_user:usv_password@db:3306/usv_hmi

# Configuración de tokens JWT
ACCESS_TOKEN_EXPIRE_MINUTES=360  # 6 horas
REFRESH_TOKEN_EXPIRE_DAYS=7      # 7 días

# Configuración de la aplicación
PROJECT_NAME=USV HMI Backend
API_V1_STR=/api/v1

# CORS - Orígenes permitidos (separados por coma)
BACKEND_CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:5173

# AWS Cognito Configuration (Obligatorio para la integración con API Gateway)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_APP_CLIENT_ID=your-cognito-app-client-id

# AWS API Gateway and IoT Configuration
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=xxxxxx-ats.iot.us-east-1.amazonaws.com
API_GATEWAY_WS_ENDPOINT=wss://xxxxx.execute-api.us-east-1.amazonaws.com/prod
API_GATEWAY_HTTP_ENDPOINT=https://xxxxx.execute-api.us-east-1.amazonaws.com/prod

# InfluxDB Configuration (Obligatorio para telemetría y seguridad de misiones)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-auth-token
INFLUXDB_ORG=usv_org
INFLUXDB_BUCKET=usv_telemetry